    "Descriptions": [
        {
            "CategoryName": "Operation Insight",
            "Descriptions": [
                {
                    "DescriptionText": "Vanilla+ 1PP PVP on Chernarus. Survive first. One Trading Post safezone. Raid weekends Friday 18:00 through Monday 06:00 server time."
                },
                {
                    "DescriptionText": "Coastal spawns: Svetloyarsk, Berezino, Elektro, Chernogorsk. World loot is lean — military ammo and guns are contested, not carpeted. The Post is a relief valve, not an MMO mall."
                }
            ]
        },
        {
            "CategoryName": "Trading Post",
            "Descriptions": [
                {
                    "DescriptionText": "Custom Insight Trading Post with clothing, weapons, building/tools, consumables and fishing, vehicles and parts, and medical. Buybacks are thin. Bring cash from scavenging, fishing, and Insight jobs."
                },
                {
                    "DescriptionText": "ATM deposit cap is limited. No personal storage mall. No aircraft trader."
                }
            ]
        },
        {
            "CategoryName": "Insight Jobs",
            "Descriptions": [
                {
                    "DescriptionText": "Talk to Mira at Green Mountain for Dead Drop and the Insight story chain. Board dailies unlock after Eyes Only. Green Mountain is NOT safe."
                },
                {
                    "DescriptionText": "Scarce contested caches can appear near NWAF / VMC when the server is alive. Bring a crew."
                }
            ]
        }
    ],
