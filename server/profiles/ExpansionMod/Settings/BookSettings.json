    "RuleCategories": [
        {
            "CategoryName": "General",
            "Rules": [
                {
                    "RuleParagraph": "1.1.",
                    "RuleText": "No cheats, macros, or exploits. Permanent ban."
                },
                {
                    "RuleParagraph": "1.2.",
                    "RuleText": "No hate speech, discrimination, or toxic harassment in chat or voice."
                },
                {
                    "RuleParagraph": "1.3.",
                    "RuleText": "Admin and staff decisions stand. Argue in Discord tickets, not in-game spam."
                },
                {
                    "RuleParagraph": "1.4.",
                    "RuleText": "No stream sniping or ghosting. Play the character you are logged in as."
                }
            ]
        },
        {
            "CategoryName": "Raiding",
            "Rules": [
                {
                    "RuleParagraph": "2.1.",
                    "RuleText": "Raiding is ONLY Friday 18:00 through Monday 06:00 (server time)."
                },
                {
                    "RuleParagraph": "2.2.",
                    "RuleText": "Use Expansion propane torch / bolt cutters inside the raid window. Mid-week raid tools will not work."
                },
                {
                    "RuleParagraph": "2.3.",
                    "RuleText": "The Trading Post safezone is never a raid target. Do not grief traders or the post build."
                }
            ]
        },
        {
            "CategoryName": "PVP and Bases",
            "Rules": [
                {
                    "RuleParagraph": "3.1.",
                    "RuleText": "1PP only. No third-person combat advantage."
                },
                {
                    "RuleParagraph": "3.2.",
                    "RuleText": "Build like the weekend is coming. Unlocked tents and open stashes are fair game anytime."
                },
                {
                    "RuleParagraph": "3.3.",
                    "RuleText": "Green Mountain Insight Cell jobs are NOT a safezone. Expect PVP."
                }
            ]
        }
    ],
